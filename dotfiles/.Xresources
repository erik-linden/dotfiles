! Gruvbox Material Dark Hard (see docs/palette.md)
*background: #1d2021
*foreground: #d4be98
*cursorColor: #d4be98
! Black + DarkGrey
*color0:  #3c3836
*color8:  #928374
! DarkRed + Red
*color1:  #ea6962
*color9:  #ea6962
! DarkGreen + Green
*color2:  #a9b665
*color10: #a9b665
! DarkYellow + Yellow
*color3:  #d8a657
*color11: #d8a657
! DarkBlue + Blue
*color4:  #7daea3
*color12: #7daea3
! DarkMagenta + Magenta
*color5:  #d3869b
*color13: #d3869b
! DarkCyan + Cyan
*color6:  #89b482
*color14: #89b482
! LightGrey + White
*color7:  #d4be98
*color15: #ddc7a1

! Overall scale for fonts in i3, polybar, rofi, dunst and kitty.
! 96 = 100%, 120 = 125%, 144 = 150%. Takes effect after logging in again.
! Check the current value with: xrdb -query | grep dpi
Xft.dpi: 96

! Font rendering (matches the gnome-tweaks settings in docs/SETUP.md)
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb
