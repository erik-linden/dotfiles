[user]
	name = Erik Lindén
	# The email is set per machine in ~/.gitconfig.local (not in this repo,
	# see [include] at the bottom). Set it with:
	#   git config --file ~/.gitconfig.local user.email <your email>
	# Refuse to commit until it is set, instead of guessing one:
	useConfigOnly = true
[core]
	editor = nvim
	# Show diffs with delta (apt: git-delta). To go back to plain git, remove
	# this line and the diffFilter line under [interactive].
	pager = delta
[init]
	defaultBranch = main
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[interactive]
	# Used by `git add -p`
	diffFilter = delta --color-only
[delta]
	# https://dandavison.github.io/delta/  Colors from docs/palette.md.
	# In the pager: n/N jump between files.
	# Side by side once: git -c delta.side-by-side=true diff
	dark = true
	navigate = true
	line-numbers = true
	syntax-theme = gruvbox-dark
	minus-style = syntax "#3c1f1e"
	minus-emph-style = syntax "#6b2e2b"
	plus-style = syntax "#32361a"
	plus-emph-style = syntax "#4d5524"
	line-numbers-minus-style = "#ea6962"
	line-numbers-plus-style = "#a9b665"
	line-numbers-zero-style = "#7c6f64"
	line-numbers-left-style = "#504945"
	line-numbers-right-style = "#504945"
	file-style = "#d8a657" bold
	file-decoration-style = "#504945" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#504945" box
	commit-decoration-style = "#d8a657" box
[diff]
	# Better diffs when code is moved around
	algorithm = histogram
	colorMoved = default
[branch]
	# `git branch` lists the most recently used first
	sort = -committerdate
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[pull]
	ff = only
[rebase]
	autoStash = true
[rerere]
	# Remember how conflicts were resolved and reuse it
	enabled = true
[merge]
	tool = p4merge
	# Also show the common ancestor in conflict markers
	conflictStyle = zdiff3
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "p4merge"]
	cmd = p4merge "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
	trustExitCode = false
[difftool]
	prompt = false
[alias]
	lg = log --graph --decorate --abbrev-commit --format=medium
	ll = log --graph --decorate --abbrev-commit --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
	lp = log --decorate --abbrev-commit --patch
	dt = difftool --tool=meld --dir-diff
	# Resolve conflicts in nvim instead of p4merge
	mt = mergetool --tool=nvimdiff
	unstage = reset HEAD --
	st = status -sb
	df = diff
	sh = show
	co = checkout
	ci = commit
	br = branch
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
# Machine specific settings (user.email etc.), last so they win. A missing
# file is silently ignored.
[include]
	path = ~/.gitconfig.local
