[user]
	name = Erik Lindén
	# The email is set per machine in ~/.gitconfig.local (not in this repo,
	# see [include] at the bottom). Set it with:
	#   git config --file ~/.gitconfig.local user.email <your email>
	# Refuse to commit until it is set, instead of guessing one:
	useConfigOnly = true
[core]
	editor = nvim
	# Show diffs with delta (apt: git-delta), or plain less if it isn't
	# installed. To go back to plain git, remove this line and the
	# diffFilter line under [interactive].
	pager = "if command -v delta >/dev/null; then delta; else less; fi"
[pager]
	# The graph aliases (git lg / git ll, also with -p): delta can't read
	# diffs drawn inside a --graph (every line starts with "| "), so these
	# use git's own diff-highlight instead, which can. It marks the changed
	# words in reverse video. (The script comes with Ubuntu's git package;
	# without it, e.g. on installs without docs, plain less.)
	lg = "f=/usr/share/doc/git/contrib/diff-highlight/diff-highlight; if [ -r $f ]; then perl $f | less; else less; fi"
	ll = "f=/usr/share/doc/git/contrib/diff-highlight/diff-highlight; if [ -r $f ]; then perl $f | less; else less; fi"
[init]
	defaultBranch = main
# Named colors come from the terminal's palette
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[interactive]
	# Used by `git add -p`
	diffFilter = "if command -v delta >/dev/null; then delta --color-only; else cat; fi"
[delta]
	# https://dandavison.github.io/delta/
	# In the pager: n/N jump between files.
	# Side by side once: git -c delta.side-by-side=true diff
	dark = true
	navigate = true
	line-numbers = true
	# Code colors from the terminal's palette (syntax-theme = ansi).
	# Removed and added lines get a background tint, with the code's syntax
	# colors on top. The tints can't be terminal colors: the terminal's red
	# and green are bright text colors, and as backgrounds they'd hide the
	# code (red code on a red line). So they are fixed hex values, a dark
	# red and green picked to go with Gruvbox (delta's defaults are a
	# generic dark red/green); "emph" is the stronger tint for the words
	# that changed within a line. The line-number and frame colors below
	# are palette.md colors.
	syntax-theme = ansi
	minus-style = syntax "#3c1f1e"
	minus-emph-style = syntax "#6b2e2b"
	plus-style = syntax "#32361a"
	plus-emph-style = syntax "#4d5524"
	line-numbers-minus-style = "#ea6962"
	line-numbers-plus-style = "#a9b665"
	line-numbers-zero-style = "#7c6f64"
	line-numbers-left-style = "#504945"
	line-numbers-right-style = "#504945"
	file-style = "#d8a657" bold
	file-decoration-style = "#504945" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#504945" box
	commit-decoration-style = "#d8a657" box
[diff]
	# Better diffs when code is moved around
	algorithm = histogram
	# Moved lines in their own colors (in delta: magenta where they were
	# taken out, cyan where they landed), also when only their indentation
	# changed, e.g. a loop level removed: an unchanged loop body shows as
	# moved, edited lines as normal red/green. (`git diff -w` hides
	# indentation changes completely.)
	colorMoved = default
	colorMovedWS = allow-indentation-change
[branch]
	# `git branch` lists the most recently used first
	sort = -committerdate
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[pull]
	ff = only
[rebase]
	autoStash = true
[rerere]
	# Remember how conflicts were resolved and reuse it
	enabled = true
[merge]
	# `git mergetool`: kdiff3 (apt) shows base, yours and theirs side by
	# side and the result below. git knows kdiff3, so it needs no command
	# line here; it starts kdiff3 with --auto, which saves and closes at
	# once if kdiff3 can resolve every conflict by itself.
	tool = kdiff3
	# Also show the common ancestor in conflict markers
	conflictStyle = zdiff3
[mergetool]
	prompt = false
	keepBackup = false
[difftool]
	prompt = false
[alias]
	lg = log --graph --decorate --abbrev-commit --format=medium
	ll = log --graph --decorate --abbrev-commit --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
	lp = log --decorate --abbrev-commit --patch
	dt = difftool --tool=meld --dir-diff
	unstage = reset HEAD --
	st = status -sb
	df = diff
	sh = show
	co = checkout
	ci = commit
	br = branch
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
# Machine specific settings (user.email etc.), last so they win. A missing
# file is silently ignored.
[include]
	path = ~/.gitconfig.local
