# i3 config file (v4)
# Reference: https://i3wm.org/docs/userguide.html
# Key binding overview for all programs: docs/keybindings.md in the dotfiles repo.

# $mod (Alt) is used for all window management.
# $super (Windows key) is used for launchers and system things.
# Avoid new $mod+Shift+<letter> bindings: PyCharm's Eclipse keymap uses many
# of them (Alt+Shift+R rename, Alt+Shift+M extract method, Alt+Shift+X run...).
# Note: the ThinLinc client only sends Super to Linux in full screen mode, so
# everything used daily must also have an Alt binding.
set $mod Mod1
set $super Mod4

set $scripts ~/.config/i3/scripts

# A size smaller than the terminal (kitty: 10). Everything scales with
# Xft.dpi in ~/.Xresources.
font pango:JetBrainsMono Nerd Font 9

# --- Look: Gruvbox Material Dark Hard (see docs/palette.md) --------------
# class                 border  backgr. text    indic.  child_border
client.focused          #473c29 #473c29 #d4be98 #d8a657 #473c29
client.focused_inactive #282828 #282828 #d4be98 #d8a657 #282828
client.unfocused        #141617 #141617 #928374 #282828 #141617
client.urgent           #ea6962 #ea6962 #1d2021 #282828 #ea6962
client.placeholder      #141617 #1d2021 #d4be98 #141617 #1d2021
client.background       #1d2021
default_border normal 5
default_floating_border normal 5

# --- Behavior ------------------------------------------------------------

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# don't let the mouse refocus windows
focus_follows_mouse no

# alt-tab like toggling between workspaces
workspace_auto_back_and_forth yes

# show dialogs that pop up while a window is fullscreen
popup_during_fullscreen smart

# no borders at the screen edges when a workspace has only one window
hide_edge_borders smart

# --- Window rules --------------------------------------------------------
# Find a window's class with: xprop | grep WM_CLASS (then click the window)
# Borders on every window. Apps that ask for "no decorations" (Electron apps
# like Chrome, VS Code, Claude) otherwise get no border at all, so you can't
# see the splits or which window has focus. Rules below can still remove it.
for_window [all] border normal 5
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="flameshot"] floating enable, border none
for_window [class="copyq"] floating enable, move position center
# PyCharm dialogs sometimes open without focus
for_window [class="^jetbrains-.+"][window_type=dialog] focus

# --- Autostart -----------------------------------------------------------
# Background programs depend on the machine (laptop/desktop/remote),
# see scripts/autostart.sh. Log: ~/.cache/i3-autostart.log
exec --no-startup-id $scripts/autostart.sh

# The bar restarts together with i3
exec_always --no-startup-id ~/.config/polybar/launch.sh

# --- Volume (the bar picks up changes by itself) -------------------------
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# --- Launchers -----------------------------------------------------------

# start a terminal (kitty, falling back to whatever is installed)
bindsym $mod+Return exec kitty || i3-sensible-terminal

# kill focused window
bindsym $mod+q kill

# rofi: applications and open windows (bindcode 40 = d on any layout)
bindcode $mod+40 exec --no-startup-id rofi -show combi
bindsym $super+space exec --no-startup-id rofi -show drun
bindsym $super+Tab exec --no-startup-id rofi -show window
bindsym $super+e exec --no-startup-id rofi -show filebrowser
bindsym $super+s exec --no-startup-id rofi -show ssh
bindsym $super+r exec --no-startup-id rofi -show run
bindsym $super+k exec --no-startup-id rofi -show keys
bindsym $super+x exec --no-startup-id rofi -show power
bindsym $mod+x exec --no-startup-id rofi -show power

# clipboard history (CopyQ): pick an earlier copy, Enter puts it back on the clipboard
bindsym $mod+y exec --no-startup-id copyq toggle

# browser, storing passwords in the GNOME keyring (started by autostart.sh).
# Chrome can't detect the keyring under i3, so it has to be told.
bindsym $mod+Shift+w exec google-chrome-stable --password-store=gnome-libsecret

# screenshot (select an area, then save/copy/annotate)
bindsym Print exec --no-startup-id flameshot gui
bindsym $super+Shift+s exec --no-startup-id flameshot gui

# notifications: close, close all, show the previous one, open its actions
bindsym $super+n exec --no-startup-id dunstctl close
bindsym $super+Shift+n exec --no-startup-id dunstctl close-all
bindsym $super+m exec --no-startup-id dunstctl history-pop
bindsym $super+period exec --no-startup-id dunstctl context

# lock the screen
bindsym $super+Escape exec --no-startup-id $scripts/lock.sh

# --- Focus and movement --------------------------------------------------

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# split in horizontal orientation
bindsym $mod+i split h

# split in vertical orientation
bindsym $mod+n split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+z focus child

# jump to the window that most recently became urgent
bindsym $mod+u [urgent=latest] focus

# scratchpad: hide a window, and bring it back (cycles if several)
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# --- Workspaces ----------------------------------------------------------

# move the current workspace to the next output
# effectively toggles when you only have two outputs
bindsym $mod+p move workspace to output right

# give the current workspace a name, e.g. "3: docs" (empty name resets it)
bindsym $super+w exec --no-startup-id $scripts/rename-workspace.sh

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- i3 itself -----------------------------------------------------------

# reload the configuration file
bindsym $mod+Ctrl+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Ctrl+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Ctrl+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

set $resize Resize
mode "$resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym q mode "default"
}
bindsym $mod+r mode "$resize"

set $system System (l) lock, (e) logout, (s) suspend, (r) reboot, (Shift+s) shutdown
mode "$system" {
        bindsym l exec --no-startup-id $scripts/lock.sh, mode "default"
        bindsym e exec --no-startup-id i3-msg exit, mode "default"
        bindsym s exec --no-startup-id systemctl suspend, mode "default"
        bindsym r exec --no-startup-id systemctl reboot, mode "default"
        bindsym Shift+s exec --no-startup-id systemctl poweroff, mode "default"

        # back to normal
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym q mode "default"
}
bindsym $mod+Control+Shift+l mode "$system"

# --- Displays (laptop) ---------------------------------------------------

# cycle: single display -> next display -> mirror -> extend
bindsym $super+p exec --no-startup-id $scripts/cycle-displays.py

# screen config GUI
bindsym $mod+Shift+p exec arandr

# touchpad toggle
bindsym $mod+Shift+Return exec --no-startup-id $scripts/toggle-touchpad.sh

