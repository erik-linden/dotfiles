/* rofi configuration (written for rofi 1.7, Ubuntu 24.04 apt)
 * Reference: man rofi, man rofi-theme
 * Dump all options with their current values: rofi -dump-config
 *
 * Modes (i3 bindings in parentheses, see docs/keybindings.md):
 *   combi       applications + open windows ($mod+d)
 *   window      open windows ($super+Tab)
 *   filebrowser files ($super+e)
 *   ssh         hosts from ~/.ssh/config and known_hosts ($super+s)
 *   run         any command on $PATH ($super+r)
 *   power       lock/logout/suspend/reboot/shutdown ($super+x, or $mod+Ctrl+Shift+l for the i3 system mode)
 * Switch between modes inside rofi with Ctrl+h/l (or Ctrl+Tab / Shift+Ctrl+Tab).
 */

configuration {
    modi: "combi,window,filebrowser,ssh,run,power:~/.config/rofi/scripts/power.sh";
    /* combi lists the applications (drun) and the open windows, without a
     * "drun"/"window" prefix (windows show as workspace, class, title) */
    combi-modi: "drun,window";
    combi-hide-mode-prefix: true;

    show-icons: true;
    terminal: "kitty";

    display-combi: "Run";
    display-window: "Windows";
    display-filebrowser: "Files";
    display-ssh: "SSH";
    display-run: "Command";
    display-power: "Power";

    drun-display-format: "{name}";
    window-format: "{w}  {c}  {t}";

    /* Fuzzy matching, best matches first */
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    case-sensitive: false;

    /* Remember frequently used entries */
    disable-history: false;

    /* Vim-like navigation: Ctrl+j/k move up/down, Ctrl+h/l switch tabs (modes).
     * These keys have other default uses, so free them first. */
    kb-accept-entry: "Return,KP_Enter,Control+m";
    kb-remove-to-eol: "";
    kb-row-down: "Down,Control+n,Control+j";
    kb-row-up: "Up,Control+p,Control+k";
    kb-remove-char-back: "BackSpace,Shift+BackSpace";
    kb-mode-complete: "";
    kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab,Control+h";
    kb-mode-next: "Shift+Right,Control+Tab,Control+l";
}

@theme "gruvbox-material-dark"
