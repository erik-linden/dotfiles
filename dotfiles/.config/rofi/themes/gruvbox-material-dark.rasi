/* Gruvbox Material Dark Hard for rofi 1.7 (see docs/palette.md) */

* {
    bg-dim:   #141617;
    bg0:      #1d2021;
    bg1:      #282828;
    bg5:      #504945;
    focus:    #473c29;
    fg0:      #d4be98;
    fg1:      #ddc7a1;
    grey:     #928374;
    red:      #ea6962;
    yellow:   #d8a657;
    blue:     #7daea3;

    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg0;
}

window {
    width: 900px;
    background-color: @bg0;
    border: 2px;
    border-color: @bg5;
}

mainbox {
    children: [ inputbar, message, listview, mode-switcher ];
    spacing: 0;
}

inputbar {
    children: [ prompt, entry, num-filtered-rows, textbox-num-sep, num-rows ];
    background-color: @bg1;
    padding: 8px 12px;
    spacing: 8px;
}

prompt {
    text-color: @yellow;
}

entry {
    placeholder: "Search";
    placeholder-color: @grey;
    cursor: text;
}

num-filtered-rows, textbox-num-sep, num-rows {
    text-color: @grey;
    expand: false;
}

textbox-num-sep {
    str: "/";
}

message {
    padding: 8px 12px;
    background-color: @bg1;
    border: 1px 0 0 0;
    border-color: @bg5;
}

textbox {
    text-color: @fg0;
}

listview {
    lines: 12;
    columns: 1;
    fixed-height: true;
    scrollbar: true;
    padding: 4px 0;
    spacing: 0;
}

scrollbar {
    handle-color: @bg5;
    handle-width: 4px;
}

element {
    padding: 4px 12px;
    spacing: 10px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg0;
}

element selected.normal {
    background-color: @focus;
    text-color: @fg1;
}

element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @blue;
}

element selected.active {
    background-color: @focus;
    text-color: @blue;
}

element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @red;
}

element selected.urgent {
    background-color: @red;
    text-color: @bg0;
}

element-icon {
    size: 1.2em;
    background-color: inherit;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    highlight: bold #d8a657;
    vertical-align: 0.5;
}

mode-switcher {
    background-color: @bg1;
    border: 1px 0 0 0;
    border-color: @bg5;
}

button {
    padding: 6px;
    text-color: @grey;
}

button selected {
    background-color: @focus;
    text-color: @yellow;
}
