# dunst notification daemon (written for dunst 1.9+, Ubuntu 24.04 apt)
# Reference: man 5 dunst, or /etc/xdg/dunst/dunstrc for all options with comments
# Test with: notify-send -u critical "Summary" "Body text"
#
# Key bindings are in the i3 config (dunst dropped its own [shortcuts]):
#   $super+n close, $super+Shift+n close all, $super+m history, $super+period actions

[global]
    ### Placement ###
    monitor = 0
    # Show on the monitor with the focused window
    follow = keyboard
    width = 400
    height = 300
    origin = top-right
    offset = 30x40
    notification_limit = 5

    ### Progress bar (e.g. volume) ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    ### Look: Gruvbox Material Dark Hard (see docs/palette.md) ###
    font = JetBrainsMono Nerd Font 10
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    separator_color = frame
    padding = 10
    horizontal_padding = 14
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#504945"
    gap_size = 4
    corner_radius = 0
    line_height = 0

    ### Text ###
    markup = full
    # %a appname, %s summary, %b body
    format = "<small>%a</small>\n<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sort = yes
    # Don't time out notifications while the user is idle (seconds)
    idle_threshold = 120

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    dmenu = /usr/bin/rofi -dmenu -p "Action"
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = true

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#1d2021"
    foreground = "#928374"
    frame_color = "#3c3836"
    highlight = "#928374"
    timeout = 4

[urgency_normal]
    background = "#1d2021"
    foreground = "#d4be98"
    frame_color = "#504945"
    highlight = "#d8a657"
    timeout = 8

[urgency_critical]
    background = "#1d2021"
    foreground = "#d4be98"
    frame_color = "#ea6962"
    highlight = "#ea6962"
    timeout = 0

# Hold back notifications while a window is fullscreen (e.g. presentations),
# except critical ones
[fullscreen_delay_everything]
    fullscreen = delay

[fullscreen_show_critical]
    msg_urgency = critical
    fullscreen = show
